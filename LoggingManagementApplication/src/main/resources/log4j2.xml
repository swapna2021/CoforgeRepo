<?xml version="1.0" encoding="UTF-8"?>
<Configuration >
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
		
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger - %msg%n"/>
		
		</Console>
		<File name="Filelogger" fileName="/Users/swapnam/swapna/eclipse-workspace-coforge/LoggingManagementApplication/logs/app.log" append="true" >
		
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger - %msg%n"/>
		</File>
		
	</Appenders>
	<Loggers>
		<Root level="info">
			<AppenderRef  ref="Console"></AppenderRef>
			<AppenderRef ref="Filelogger"></AppenderRef>
		</Root>
		
	</Loggers>
	
	

</Configuration>